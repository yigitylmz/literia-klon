rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Another user may only add or remove their own uid in the followers list.
    function followersOnlyChangedBySelf() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers'])
        && request.resource.data.followers.toSet().difference(resource.data.followers.toSet()).hasOnly([request.auth.uid])
        && resource.data.followers.toSet().difference(request.resource.data.followers.toSet()).hasOnly([request.auth.uid]);
    }

    // Unique nicknames: nicknames/{nick} -> { uid }
    match /nicknames/{nick} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || (signedIn() && followersOnlyChangedBySelf());
      allow delete: if false;

      match /books/{bookId} {
        allow read: if signedIn();
        allow write: if isOwner(userId);
      }

      match /sessions/{sessionId} {
        allow read: if signedIn();
        allow write: if isOwner(userId);
      }
    }
  }
}
